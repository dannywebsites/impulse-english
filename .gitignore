*.zip

# social-repurpose: the TikTok archive rail.
# 262 clips must never enter the repo — this root IS the git repo.
# Scoped to this folder on purpose: a blanket *.mp4 would silently swallow
# future site videos in March-Impulse-Web-.../public/media/ (3 are tracked today).
social-repurpose/clips/
social-repurpose/clips-normalised/
social-repurpose/out/
social-repurpose/**/*.mp4
social-repurpose/**/*.mov
social-repurpose/**/*.info.json

# API keys live in ~/.ai-os/postforme.env (mode 600), never in the repo.
social-repurpose/*.env
social-repurpose/archive.jsonl
social-repurpose/*.log
social-repurpose/keepers.txt
social-repurpose/accounts.json
social-repurpose/media_cache.json

# Scraped Facebook media — staging only, never committed.
# Contains identifiable minors with no documented consent for web use (GDPR/LOPDGDD).
# Images move to public/images/ ONLY after manifest.json marks them consentCleared.
new fotos/facebook-scrape/

# ── Desktop-sync artefacts ──────────────────────────────────────────────────
# This repo root lives in a synced Desktop folder, and the sync forks any file
# edited in two places into "name 2.ext", "name 3.ext"… 192 of them had piled up.
# They are duplicates of tracked sources and must never be committed.
* [0-9].*
* [0-9]
* [0-9]/

# Timestamped backup twins written beside their source before an edit. Committing
# one ships dead code; one under public/ would be copied verbatim into dist/.
*.bak-*

.DS_Store

# Machine-local Claude Code permissions — per-Mac, not project config.
.claude/settings.local*.json

# Astro content cache: regenerated by every build, 2MB+ per file.
March-Impulse-Web-*/.astro/
seo-writer/.vite/

# The competitor-neutrality regression fixture. It recommends EEI, IberEnglish and
# Suma-T by name and sends budget buyers to a rival, which is why it was never
# published. It sits in src/content/articles/, so Astro builds it on sight —
# ignored so a future `git add -A` cannot put it live. See
# ~/.claude/skills/seo-blog-writer/references/listicle-guide.md "The fixture".
March-Impulse-Web-*/src/content/articles/mejores-academias-ingles-plaza-castilla.md

# ── Photo/video staging, never in the repo ──────────────────────────────────
# "new fotos/" is 885MB (246 files incl. .mov) and "en el extrangero/" 37MB. Both are
# raw camera dumps of students, and the facebook-scrape rule above already flags the
# consent problem: images move into public/images/ only once consent is documented.
# Size alone also disqualifies them — GitHub rejects blobs over 100MB.
new fotos/
en el extrangero/

# Post for Me API responses, one JSON per scheduled post (1552 and counting).
# Same reasoning as social-repurpose/out/ above.
social-repurpose/out-facebook/
