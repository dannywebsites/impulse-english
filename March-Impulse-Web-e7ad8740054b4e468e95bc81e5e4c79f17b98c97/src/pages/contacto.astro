---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactoPage, { faqs } from '../../pages/ContactoPage';
import CookieBanner from '../../components/CookieBanner';
import { generateBreadcrumbSchema, generateFAQSchema } from '../../utils/schemaData';
import { channelVideoSchema } from '../../utils/channelVideos';

const breadcrumb = generateBreadcrumbSchema([
  { name: 'Inicio', url: 'https://impulse-english.es/' },
  { name: 'Contacto', url: 'https://impulse-english.es/contacto/' },
]);
---

<BaseLayout
  title="Contacto"
  description="Contacta con Impulse English Academy. Av. de El Ferrol 22, La Vaguada, Madrid. Tel: 604 910 611. Prueba de nivel gratuita. Metro Barrio del Pilar."
  keywords="contacto academia inglés madrid, dirección impulse english, teléfono academia inglés la vaguada, horarios academia inglés"
  canonical="/contacto/"
  schemas={[channelVideoSchema('quienesSomos'), breadcrumb, generateFAQSchema(faqs)]}
>
  <ContactoPage client:load />
  <CookieBanner client:idle />
</BaseLayout>
