---
import BaseLayout from '../layouts/BaseLayout.astro';
import LaVentillaPage, { locationMeta, localFaqs } from '../../pages/ubicaciones/LaVentillaPage';
import CookieBanner from '../../components/CookieBanner';
import { generateLocationPageSchema, generateFAQSchema, generateBreadcrumbSchema } from '../../utils/schemaData';

const locationSchema = generateLocationPageSchema(locationMeta);
const locationItems = locationSchema["@graph"] || [locationSchema];
const breadcrumb = generateBreadcrumbSchema([
  { name: 'Inicio', url: 'https://impulse-english.es/' },
  { name: 'Ubicaciones', url: 'https://impulse-english.es/academias-ingles-madrid/por-barrios/' },
  { name: locationMeta.locationName, url: `${locationMeta.pageUrl}/` },
]);
const schemas = [...locationItems, breadcrumb, ...(localFaqs?.length > 0 ? [generateFAQSchema(localFaqs)] : [])];
---

<BaseLayout
  title="Inglés a una parada de La Ventilla | desde 64 € | Impulse"
  description="A una parada en la L9: Ventilla → Barrio del Pilar. Centro oficial Cambridge, grupos de 7 a 10, desde 64 €/mes y 29 €/hora particular. 5,0 sobre 183 reseñas. Prueba de nivel gratis con JP: 604 910 611."
  keywords="academia inglés la ventilla, clases inglés la ventilla, cursos inglés la ventilla madrid, cambridge la ventilla, aprender inglés la ventilla"
  canonical="/academia-ingles-la-ventilla/"
  fullTitle={true}
  schemas={schemas}
>
  <LaVentillaPage client:idle />
  <CookieBanner client:idle />
</BaseLayout>
