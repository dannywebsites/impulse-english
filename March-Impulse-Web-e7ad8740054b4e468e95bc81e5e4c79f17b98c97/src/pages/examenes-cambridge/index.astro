---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CambridgeHubPage, { articleSchema, courseSchema } from '../../../pages/examenes-cambridge/CambridgeHubPage';
import CookieBanner from '../../../components/CookieBanner';
import { channelVideoSchema } from '../../../utils/channelVideos';

// The page embeds this clip through <LazyVideo>; without the VideoObject it is
// invisible to Google. Metadata comes from utils/channelVideos.ts so the duration
// and upload date cannot drift from the channel.
const schemas = [
  articleSchema,
  courseSchema,
  channelVideoSchema('quienesSomos'),
];
---

<BaseLayout
  title="Exámenes Cambridge"
  description="Centro preparador Cambridge oficial en Madrid. B1 Preliminary, B2 First, C1 Advanced. 100% de aprobados en el curso 2024/25 (alumnos presentados). La Vaguada."
  keywords="exámenes cambridge madrid, preparación cambridge, b2 first madrid, c1 advanced madrid, centro cambridge oficial"
  canonical="/examenes-cambridge/"
  schemas={schemas}
>
  <CambridgeHubPage client:idle />
  <CookieBanner client:idle />
</BaseLayout>
