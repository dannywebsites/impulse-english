---
import BaseLayout from '../../layouts/BaseLayout.astro';
import B2FirstPage, { courseSchema, b2Faqs } from '../../../pages/examenes-cambridge/B2FirstPage';
import CookieBanner from '../../../components/CookieBanner';
import { generateFAQSchema } from '../../../utils/schemaData';
import { channelVideoSchema } from '../../../utils/channelVideos';

// The page embeds this clip through <LazyVideo>; without the VideoObject it is
// invisible to Google. Metadata comes from utils/channelVideos.ts so the duration
// and upload date cannot drift from the channel.
const schemas = [
  courseSchema,
  ...(b2Faqs?.length > 0 ? [generateFAQSchema(b2Faqs)] : []),
  channelVideoSchema('quienesSomos'),
];
---

<BaseLayout
  title="Preparación Cambridge B2 First"
  description="Preparación Cambridge B2 First (FCE) en Madrid. Centro oficial Cambridge, 100% de aprobados en el curso 2024/25 (alumnos presentados). La Vaguada."
  keywords="b2 first madrid, preparación fce cambridge, examen b2 cambridge, curso b2 inglés madrid, academia cambridge b2, first certificate"
  canonical="/examenes-cambridge/b2-first/"
  schemas={schemas}
>
  <B2FirstPage client:idle />
  <CookieBanner client:idle />
</BaseLayout>
