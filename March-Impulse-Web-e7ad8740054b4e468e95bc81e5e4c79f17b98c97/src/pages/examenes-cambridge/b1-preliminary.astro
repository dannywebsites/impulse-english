---
import BaseLayout from '../../layouts/BaseLayout.astro';
import B1PreliminaryPage, { courseSchema, b1Faqs } from '../../../pages/examenes-cambridge/B1PreliminaryPage';
import CookieBanner from '../../../components/CookieBanner';
import { generateFAQSchema } from '../../../utils/schemaData';

const schemas = [
  courseSchema,
  ...(b1Faqs?.length > 0 ? [generateFAQSchema(b1Faqs)] : []),
];
---

<BaseLayout
  title="Preparación Cambridge B1 PET"
  description="Preparación examen Cambridge B1 Preliminary (PET) en Madrid. Centro oficial Cambridge, 100% de aprobados en 2024/25 (alumnos presentados). Grupos reducidos."
  keywords="b1 preliminary madrid, preparación pet cambridge, examen b1 cambridge, curso b1 inglés madrid, academia cambridge b1, pet inglés"
  canonical="/examenes-cambridge/b1-preliminary/"
  schemas={schemas}
>
  <B1PreliminaryPage client:idle />
  <CookieBanner client:idle />
</BaseLayout>
