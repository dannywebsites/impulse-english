---
import BaseLayout from '../layouts/BaseLayout.astro';
import TetuanPage, { locationMeta, localFaqs } from '../../pages/ubicaciones/TetuanPage';
import CookieBanner from '../../components/CookieBanner';
import { generateLocationPageSchema, generateFAQSchema, generateBreadcrumbSchema } from '../../utils/schemaData';

const locationSchema = generateLocationPageSchema(locationMeta);
const locationItems = locationSchema["@graph"] || [locationSchema];
const breadcrumb = generateBreadcrumbSchema([
  { name: 'Inicio', url: 'https://impulse-english.es/' },
  { name: 'Ubicaciones', url: 'https://impulse-english.es/academias-ingles-madrid/por-barrios/' },
  { name: locationMeta.locationName, url: `${locationMeta.pageUrl}/` },
]);
const schemas = [...locationItems, breadcrumb, ...(localFaqs?.length > 0 ? [generateFAQSchema(localFaqs)] : [])];
---

<BaseLayout
  title="Academia de inglés en Tetuán | Bus 147 directo | Impulse"
  description="El bus 147 te deja en la puerta desde Tetuán, directo y sin transbordos. Centro oficial Cambridge, grupos de 7 a 10, desde 64 €/mes y 29 €/hora particular. 5,0 sobre 183 reseñas. Prueba de nivel gratis con JP: 604 910 611."
  keywords="academia inglés tetuán, clases inglés tetuán madrid, cursos inglés tetuán, cambridge tetuán, aprender inglés tetuán"
  canonical="/academia-ingles-tetuan/"
  fullTitle={true}
  schemas={schemas}
>
  <TetuanPage client:idle />
  <CookieBanner client:idle />
</BaseLayout>
