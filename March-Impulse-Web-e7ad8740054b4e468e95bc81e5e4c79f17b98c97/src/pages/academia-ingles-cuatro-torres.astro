---
import BaseLayout from '../layouts/BaseLayout.astro';
import CuatroTorresPage, { locationMeta, localFaqs } from '../../pages/ubicaciones/CuatroTorresPage';
import CookieBanner from '../../components/CookieBanner';
import { generateLocationPageSchema, generateFAQSchema, generateBreadcrumbSchema } from '../../utils/schemaData';

const locationSchema = generateLocationPageSchema(locationMeta);
const locationItems = locationSchema["@graph"] || [locationSchema];
const breadcrumb = generateBreadcrumbSchema([
  { name: 'Inicio', url: 'https://impulse-english.es/' },
  { name: 'Ubicaciones', url: 'https://impulse-english.es/academias-ingles-madrid/por-barrios/' },
  { name: locationMeta.locationName, url: `${locationMeta.pageUrl}/` },
]);
const schemas = [...locationItems, breadcrumb, ...(localFaqs?.length > 0 ? [generateFAQSchema(localFaqs)] : [])];
---

<BaseLayout
  title="Inglés de negocios en Cuatro Torres | desde 29 €/h | Impulse"
  description="Para profesionales del CTBA: inglés de negocios con Danny, centro oficial Linguaskill con certificado en 48 h, particulares 29 €/hora y grupos de adultos 94 €/mes. 5,0 sobre 183 reseñas. Prueba de nivel gratis: 604 910 611."
  keywords="academia inglés cuatro torres, clases inglés ctba, cursos inglés cuatro torres madrid, cambridge cuatro torres, aprender inglés profesionales madrid"
  canonical="/academia-ingles-cuatro-torres/"
  fullTitle={true}
  schemas={schemas}
>
  <CuatroTorresPage client:idle />
  <CookieBanner client:idle />
</BaseLayout>
