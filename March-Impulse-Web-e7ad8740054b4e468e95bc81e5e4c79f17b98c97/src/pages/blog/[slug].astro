---
/**
 * Dynamic route for PAA (People Also Ask) articles.
 * Generates static pages at build time from Content Collections.
 *
 * Static .astro files (e.g. cuantas-veces-b2-first.astro) take priority
 * over this dynamic route — Astro resolves static routes first.
 * New articles added to Content Collections without a static .astro file
 * will be generated by this route.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PAAArticlePage from '../../../components/PAAArticlePage';
import CookieBanner from '../../../components/CookieBanner';
import { getBlogSiblingCards } from '../../../data/blog-directory';
import { generateArticleSchema, generateFAQSchema, businessInfo, toCanonicalPageUrl } from '../../../utils/schemaData';
import type { PAAArticle } from '../../../data/articles/types';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({
    // entry.id includes the .md extension in Astro 5, strip it for clean URLs
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const slug = entry.id.replace(/\.md$/, '');
const data = entry.data;

// The auto-publish pipeline writes slashless URLs in frontmatter; the site canonical
// is trailing-slash, so normalize every rendered link (article URL, breadcrumbs, CTAs)
// or they all eat a 308 hop.
const normalizedData = {
  ...data,
  url: toCanonicalPageUrl(data.url),
  breadcrumbs: data.breadcrumbs.map((b) => (b.href ? { ...b, href: toCanonicalPageUrl(b.href) } : b)),
  impulseSection: {
    ...data.impulseSection,
    ctaLinks: data.impulseSection.ctaLinks.map((c) => ({ ...c, href: toCanonicalPageUrl(c.href) })),
  },
};

// Reconstruct the article object with slug for PAAArticlePage compatibility.
// Frontmatter category is a free string (zod); PAAArticlePage falls back safely
// for unknown values, so the cast is sound.
const article = { slug, ...normalizedData, category: normalizedData.category as PAAArticle['category'] };

const siblings = getBlogSiblingCards(slug, 3);
const fullUrl = `${businessInfo.url}${normalizedData.url}`;

// Build schemas for BaseLayout server-side rendering
const schemaImage = data.articleImages?.[0]?.url
  ?? `/images/academy/6e08cd95-47b7-4d36-95c7-fecfb41e3883.jpeg`;

const articleSchema = generateArticleSchema({
  headline: data.seoTitle,
  description: data.metaDescription,
  url: fullUrl,
  image: schemaImage,
  datePublished: data.publishedDate,
  dateModified: data.modifiedDate,
  wordCount: 1500,
});

const schemas: object[] = [articleSchema];
if (data.faqItems.length > 0) {
  schemas.push(generateFAQSchema(data.faqItems));
}
---

<BaseLayout
  title={data.seoTitle}
  description={data.metaDescription}
  canonical={data.url}
  ogType="article"
  publishedTime={data.publishedDate}
  modifiedTime={data.modifiedDate}
  schemas={schemas}
>
  <PAAArticlePage article={article} siblingArticles={siblings} client:idle />
  <CookieBanner client:idle />
</BaseLayout>
