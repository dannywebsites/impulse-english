---
/**
 * Dynamic route for PAA (People Also Ask) articles.
 * Generates static pages at build time from Content Collections.
 *
 * Static .astro files (e.g. cuantas-veces-b2-first.astro) take priority
 * over this dynamic route — Astro resolves static routes first.
 * New articles added to Content Collections without a static .astro file
 * will be generated by this route.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PAAArticlePage from '../../../components/PAAArticlePage';
import CookieBanner from '../../../components/CookieBanner';
import { getBlogSiblingCards } from '../../../data/blog-directory';
import { generateArticleSchema, generateFAQSchema, generateItemListSchema, generateVideoObjectSchema, businessInfo, toCanonicalPageUrl } from '../../../utils/schemaData';
import { EXTRANJERO_CATEGORY } from '../../../utils/extranjeroCluster';
import { APRENDE_INGLES_CATEGORY } from '../../../utils/aprendeInglesCluster';
import type { PAAArticle } from '../../../data/articles/types';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles
    // The study-abroad cluster is built by blog/extranjero/[slug].astro instead.
    // This exclusion is load-bearing: leave it out and each of those articles is
    // emitted at BOTH paths, a real file then sits at every redirect source, and
    // the 308s in vercel.json quietly stop mattering.
    .filter((entry) => entry.data.category !== EXTRANJERO_CATEGORY)
    // Same for the learn-English cluster, built by aprende-ingles/[slug].astro.
    // These articles have no legacy /blog/ URLs, so there are no redirects to
    // defeat — but a twin at /blog/<slug>/ would be a duplicate of the canonical
    // page competing with it, which is worse.
    .filter((entry) => entry.data.category !== APRENDE_INGLES_CATEGORY)
    .map((entry) => ({
      // entry.id includes the .md extension in Astro 5, strip it for clean URLs
      params: { slug: entry.id.replace(/\.md$/, '') },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const slug = entry.id.replace(/\.md$/, '');
const data = entry.data;

// The auto-publish pipeline writes slashless URLs in frontmatter; the site canonical
// is trailing-slash, so normalize every rendered link (article URL, breadcrumbs, CTAs)
// or they all eat a 308 hop.
const normalizedData = {
  ...data,
  url: toCanonicalPageUrl(data.url),
  breadcrumbs: data.breadcrumbs.map((b) => (b.href ? { ...b, href: toCanonicalPageUrl(b.href) } : b)),
  impulseSection: {
    ...data.impulseSection,
    ctaLinks: data.impulseSection.ctaLinks.map((c) => ({ ...c, href: toCanonicalPageUrl(c.href) })),
  },
};

// Reconstruct the article object with slug for PAAArticlePage compatibility.
// Frontmatter category is a free string (zod); PAAArticlePage falls back safely
// for unknown values, so the cast is sound.
const article = { slug, ...normalizedData, category: normalizedData.category as PAAArticle['category'] };

const siblings = getBlogSiblingCards(slug, 3);
const fullUrl = `${businessInfo.url}${normalizedData.url}`;

// Build schemas for BaseLayout server-side rendering
const schemaImage = data.articleImages?.[0]?.url
  ?? `/images/academy/6e08cd95-47b7-4d36-95c7-fecfb41e3883.jpeg`;

const articleSchema = generateArticleSchema({
  headline: data.seoTitle,
  description: data.metaDescription,
  url: fullUrl,
  image: schemaImage,
  datePublished: data.publishedDate,
  dateModified: data.modifiedDate,
  wordCount: 1500,
});

const schemas: object[] = [articleSchema];
if (data.faqItems.length > 0) {
  schemas.push(generateFAQSchema(data.faqItems));
}
// Ranked listicles carry an ItemList so the ranking itself is machine-readable, not just
// the prose that describes it.
const isListicle = !!(data.listItems && data.listItems.length > 0);
if (isListicle) {
  schemas.push(generateItemListSchema(data.listItems!, data.seoTitle));
}
// Channel clips. Kept identical to aprende-ingles/[slug].astro so an article that
// moves between the two clusters keeps its video markup unchanged.
if (data.videos?.length) {
  for (const v of data.videos) {
    schemas.push(
      generateVideoObjectSchema({
        name: v.title,
        description: v.description,
        embedUrl: `https://www.youtube.com/embed/${v.youtubeId}`,
        thumbnailUrl: `https://i.ytimg.com/vi/${v.youtubeId}/oardefault.jpg`,
        uploadDate: v.uploadDate,
        duration: v.duration,
      })
    );
  }
}
// A listicle's <title> is its own seoTitle verbatim — no brand chain. It needs the full 60
// characters for a ranked, numbered, dated headline, and on a Tetuán-targeted page the default
// chain injects "La Vaguada", a competing location term. The brand moves to the social card,
// which has no length limit. Ordinary articles keep buildPageTitle's chain.
---

<BaseLayout
  title={data.seoTitle}
  description={data.metaDescription}
  {...(isListicle ? { fullTitle: true, ogTitle: `${data.seoTitle} | Impulse English Academy` } : {})}
  canonical={data.url}
  ogType="article"
  publishedTime={data.publishedDate}
  modifiedTime={data.modifiedDate}
  schemas={schemas}
>
  <PAAArticlePage article={article} siblingArticles={siblings} client:idle />
  <CookieBanner client:idle />
</BaseLayout>
