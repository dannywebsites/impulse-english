---
/**
 * Blog archive / HTML sitemap of every article.
 *
 * SEO purpose: server-render a crawlable <a> link to EVERY article on the site —
 * the full registry (data/blog-directory.ts: static wrappers + content collection)
 * plus any auto-published collection article not yet in the generated registry,
 * plus a few hand-built guide pages that live outside /blog/. Linked sitewide from
 * the footer, so every article keeps at least one internal inbound link with zero
 * manual upkeep.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar';
import Footer from '../../../components/Footer';
import CookieBanner from '../../../components/CookieBanner';
import { getCollection } from 'astro:content';
import { BLOG_DIRECTORY, getDirectoryByCategory } from '../../../data/blog-directory';

// trailingSlash is 'always' — normalize so internal links don't take a 308 hop.
const withSlash = (u: string) => (u.endsWith('/') ? u : `${u}/`);

// Auto-published newcomers not yet in the generated registry still get listed.
const known = new Set(BLOG_DIRECTORY.map((e) => e.slug));
const newcomers = (await getCollection('articles'))
  .filter((a) => !known.has(a.id.replace(/\.md$/, '')))
  .map((a) => ({ url: withSlash(a.data.url), title: a.data.seoTitle || a.data.question }));

const groups = getDirectoryByCategory().map((g) => ({
  label: g.category,
  entries: g.entries.map((e) => ({ url: e.url, title: e.title })),
}));
if (newcomers.length > 0) {
  groups.push({ label: 'Novedades', entries: newcomers });
}

const totalArticles = BLOG_DIRECTORY.length + newcomers.length;

// Hand-built pages that live outside /blog/ and would otherwise stay orphaned.
const guiasDestacadas = [
  { url: '/academias-ingles-madrid/', title: 'Academias de inglés en Madrid (guía)' },
  { url: '/preparacion-b2-first-madrid/', title: 'Preparación del B2 First en Madrid' },
];
---

<BaseLayout
  title="Todos los artículos del blog | Impulse English Academy"
  description="Índice completo del blog de Impulse English Academy: guías de exámenes Cambridge B2 First y C1 Advanced, Linguaskill, precios, métodos y academias de inglés en Madrid."
  canonical="/blog/todos/"
>
  <Navbar client:load currentPath="/blog/todos/" />

  <main class="bg-white pt-28 md:pt-32 pb-20">
    <div class="container mx-auto px-6 md:px-12 max-w-4xl">
      <nav class="text-sm text-zinc-500 mb-6">
        <a href="/" class="hover:text-zinc-900">Inicio</a> ·
        <a href="/blog/" class="hover:text-zinc-900">Blog</a> ·
        <span class="text-zinc-700">Todos los artículos</span>
      </nav>

      <h1 class="font-serif text-3xl md:text-5xl text-zinc-900 tracking-tight mb-4">
        Todos los artículos del blog
      </h1>
      <div class="w-16 h-0.5 bg-brand-red mb-6"></div>
      <p class="text-zinc-600 mb-12 max-w-2xl">
        Índice completo de nuestras guías sobre exámenes Cambridge, Linguaskill, precios y
        cómo aprender inglés en Madrid. {totalArticles + guiasDestacadas.length} recursos y contando.
      </p>

      <section class="mb-12">
        <h2 class="text-xl font-bold text-zinc-900 mb-4">Guías destacadas</h2>
        <ul class="space-y-2">
          {guiasDestacadas.map((a) => (
            <li>
              <a href={a.url} class="text-accent-blue hover:text-brand-red hover:underline transition-colors">
                {a.title}
              </a>
            </li>
          ))}
        </ul>
      </section>

      {groups.map((group) => (
        <section class="mb-12">
          <h2 class="text-xl font-bold text-zinc-900 mb-4">{group.label}</h2>
          <ul class="space-y-2">
            {group.entries.map((a) => (
              <li>
                <a href={a.url} class="text-accent-blue hover:text-brand-red hover:underline transition-colors">
                  {a.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>

  <Footer />
  <CookieBanner client:idle />
</BaseLayout>
