---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SecundariaPage, { courseSchema, faqs } from '../../../pages/cursos/SecundariaPage';
import CookieBanner from '../../../components/CookieBanner';
import { generateBreadcrumbSchema, generateFAQSchema, generateLocationPageSchema } from '../../../utils/schemaData';
import { channelVideoSchema } from '../../../utils/channelVideos';

const locationSchema = generateLocationPageSchema({
  locationName: 'La Vaguada',
  pageUrl: 'https://impulse-english.es/cursos-ingles/secundaria',
});
const locationItems = locationSchema["@graph"] || [locationSchema];
const breadcrumb = generateBreadcrumbSchema([
  { name: 'Inicio', url: 'https://impulse-english.es/' },
  { name: 'Cursos de Inglés', url: 'https://impulse-english.es/cursos-ingles/' },
  { name: 'Inglés Secundaria y EBAU', url: 'https://impulse-english.es/cursos-ingles/secundaria/' },
]);
// The page embeds this clip through <LazyVideo>; without the VideoObject it is
// invisible to Google. Metadata comes from utils/channelVideos.ts so the duration
// and upload date cannot drift from the channel.
const schemas = [
  ...locationItems,
  breadcrumb,
  courseSchema,
  ...(faqs?.length > 0 ? [generateFAQSchema(faqs)] : []),
  channelVideoSchema('secundaria'),
];

---

<BaseLayout
  title="Inglés para Secundaria y EBAU | Cambridge | Impulse English"
  fullTitle={true}
  description="Clases de inglés para la ESO, Bachillerato y EBAU en La Vaguada. Preparación Cambridge B1, B2 y C1 en grupos reducidos, desde 87 €/mes."
  keywords="clases inglés secundaria la vaguada, preparación EBAU inglés, cambridge b1 b2 c1 adolescentes, inglés bachillerato barrio del pilar"
  canonical="/cursos-ingles/secundaria/"
  schemas={schemas}
>
  <SecundariaPage client:idle />
  <CookieBanner client:idle />
</BaseLayout>
