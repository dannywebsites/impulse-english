---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SecundariaPage, { courseSchema, faqs } from '../../../pages/cursos/SecundariaPage';
import CookieBanner from '../../../components/CookieBanner';
import { generateFAQSchema } from '../../../utils/schemaData';

const schemas = [
  courseSchema,
  ...(faqs?.length > 0 ? [generateFAQSchema(faqs)] : []),
];
---

<BaseLayout
  title="Inglés para Secundaria y EBAU | Cambridge | Impulse English"
  fullTitle={true}
  description="Clases de inglés para la ESO, Bachillerato y EBAU en La Vaguada. Preparación Cambridge B1, B2 y C1 en grupos reducidos, desde 87 €/mes."
  keywords="clases inglés secundaria la vaguada, preparación EBAU inglés, cambridge b1 b2 c1 adolescentes, inglés bachillerato barrio del pilar"
  canonical="/cursos-ingles/secundaria/"
  schemas={schemas}
>
  <SecundariaPage client:idle />
  <CookieBanner client:idle />
</BaseLayout>
