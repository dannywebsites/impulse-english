---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdultosPage, { courseSchema, faqs } from '../../../pages/cursos/AdultosPage';
import CookieBanner from '../../../components/CookieBanner';
import { generateFAQSchema } from '../../../utils/schemaData';

const schemas = [
  courseSchema,
  ...(faqs?.length > 0 ? [generateFAQSchema(faqs)] : []),
];
---

<BaseLayout
  title="Clases de Inglés para Adultos Madrid | Cambridge | Impulse"
  fullTitle={true}
  description="Clases de inglés para adultos en La Vaguada y Barrio del Pilar, 94 €/mes. Grupos de máximo 8, horarios de mañana y tarde. Prueba de nivel gratuita."
  keywords="cursos inglés adultos la vaguada, clases inglés adultos barrio del pilar, inglés para adultos madrid, cambridge adultos"
  canonical="/cursos-ingles/adultos/"
  schemas={schemas}
>
  <AdultosPage client:idle />
  <CookieBanner client:idle />
</BaseLayout>
