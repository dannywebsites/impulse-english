---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrimariaPage, { courseSchema, faqs } from '../../../pages/cursos/PrimariaPage';
import CookieBanner from '../../../components/CookieBanner';
import { generateFAQSchema } from '../../../utils/schemaData';

const schemas = [
  courseSchema,
  ...(faqs?.length > 0 ? [generateFAQSchema(faqs)] : []),
];
---

<BaseLayout
  title="Clases de Inglés para Primaria | Cambridge | Impulse"
  fullTitle={true}
  description="Clases de inglés para primaria (6-12 años) en La Vaguada y Barrio del Pilar. Cambridge Young Learners, grupos reducidos, 83 €/mes."
  keywords="clases inglés primaria la vaguada, cambridge young learners, inglés niños 6-12 años, academia inglés primaria barrio del pilar"
  canonical="/cursos-ingles/primaria/"
  schemas={schemas}
>
  <PrimariaPage client:idle />
  <CookieBanner client:idle />
</BaseLayout>
