---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OnlinePage, { courseSchema, faqs } from '../../../pages/cursos/OnlinePage';
import CookieBanner from '../../../components/CookieBanner';
import { generateBreadcrumbSchema, generateFAQSchema, generateLocationPageSchema } from '../../../utils/schemaData';

const locationSchema = generateLocationPageSchema({
  locationName: 'La Vaguada',
  pageUrl: 'https://impulse-english.es/cursos-ingles/online',
});
const locationItems = locationSchema["@graph"] || [locationSchema];
const breadcrumb = generateBreadcrumbSchema([
  { name: 'Inicio', url: 'https://impulse-english.es/' },
  { name: 'Cursos de Inglés', url: 'https://impulse-english.es/cursos-ingles/' },
  { name: 'Clases de Inglés Online', url: 'https://impulse-english.es/cursos-ingles/online/' },
]);
const schemas = [
  ...locationItems,
  breadcrumb,
  courseSchema,
  ...(faqs?.length > 0 ? [generateFAQSchema(faqs)] : []),
];

---

<BaseLayout
  title="Clases de Inglés Online en Directo | Cambridge | Impulse"
  fullTitle={true}
  description="Clases de inglés online en directo con profesor, grupos de máximo 8. Preparación Cambridge y Linguaskill desde cualquier punto de España."
  keywords="clases inglés online, cursos inglés online españa, inglés online directo, clases inglés videoconferencia, cambridge online, linguaskill online"
  canonical="/cursos-ingles/online/"
  schemas={schemas}
>
  <OnlinePage client:idle />
  <CookieBanner client:idle />
</BaseLayout>
