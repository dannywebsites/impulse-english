---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OnlinePage, { courseSchema, faqs } from '../../../pages/cursos/OnlinePage';
import CookieBanner from '../../../components/CookieBanner';
import { generateFAQSchema } from '../../../utils/schemaData';

const schemas = [
  courseSchema,
  ...(faqs?.length > 0 ? [generateFAQSchema(faqs)] : []),
];
---

<BaseLayout
  title="Clases de Inglés Online en Directo | Cambridge | Impulse"
  fullTitle={true}
  description="Clases de inglés online en directo con profesor, grupos de máximo 8. Preparación Cambridge y Linguaskill desde cualquier punto de España."
  keywords="clases inglés online, cursos inglés online españa, inglés online directo, clases inglés videoconferencia, cambridge online, linguaskill online"
  canonical="/cursos-ingles/online/"
  schemas={schemas}
>
  <OnlinePage client:idle />
  <CookieBanner client:idle />
</BaseLayout>
