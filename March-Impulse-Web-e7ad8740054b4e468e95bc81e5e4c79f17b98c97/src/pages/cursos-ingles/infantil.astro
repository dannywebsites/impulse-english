---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfantilPage, { courseSchema, faqs } from '../../../pages/cursos/InfantilPage';
import CookieBanner from '../../../components/CookieBanner';
import { generateBreadcrumbSchema, generateFAQSchema, generateLocationPageSchema } from '../../../utils/schemaData';
import { channelVideoSchema } from '../../../utils/channelVideos';

const locationSchema = generateLocationPageSchema({
  locationName: 'La Vaguada',
  pageUrl: 'https://impulse-english.es/cursos-ingles/infantil',
});
const locationItems = locationSchema["@graph"] || [locationSchema];
const breadcrumb = generateBreadcrumbSchema([
  { name: 'Inicio', url: 'https://impulse-english.es/' },
  { name: 'Cursos de Inglés', url: 'https://impulse-english.es/cursos-ingles/' },
  { name: 'Inglés Infantil (2-5 años)', url: 'https://impulse-english.es/cursos-ingles/infantil/' },
]);
// The page embeds this clip through <LazyVideo>; without the VideoObject it is
// invisible to Google. Metadata comes from utils/channelVideos.ts so the duration
// and upload date cannot drift from the channel.
const schemas = [
  ...locationItems,
  breadcrumb,
  courseSchema,
  ...(faqs?.length > 0 ? [generateFAQSchema(faqs)] : []),
  channelVideoSchema('primaria'),
];

---

<BaseLayout
  title="Clases de Inglés Infantil 2-5 Años | Clase gratis | Impulse"
  fullTitle={true}
  description="Clases de inglés para niños de 2 a 5 años en La Vaguada. Método Great Little People 100% en inglés, grupos de máximo 7, desde 64 €/mes."
  keywords="clases inglés niños la vaguada, inglés infantil barrio del pilar, inglés bebes 2 años, great little people, academia inglés niños madrid"
  canonical="/cursos-ingles/infantil/"
  schemas={schemas}
>
  <InfantilPage client:idle />
  <CookieBanner client:idle />
</BaseLayout>
