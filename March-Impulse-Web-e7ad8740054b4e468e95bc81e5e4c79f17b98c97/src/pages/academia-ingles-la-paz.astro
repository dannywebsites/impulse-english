---
import BaseLayout from '../layouts/BaseLayout.astro';
import LaPazPage, { locationMeta, localFaqs } from '../../pages/ubicaciones/LaPazPage';
import CookieBanner from '../../components/CookieBanner';
import { generateLocationPageSchema, generateFAQSchema, generateBreadcrumbSchema } from '../../utils/schemaData';

const locationSchema = generateLocationPageSchema(locationMeta);
const locationItems = locationSchema["@graph"] || [locationSchema];
const breadcrumb = generateBreadcrumbSchema([
  { name: 'Inicio', url: 'https://impulse-english.es/' },
  { name: 'Ubicaciones', url: 'https://impulse-english.es/academias-ingles-madrid/por-barrios/' },
  { name: locationMeta.locationName, url: `${locationMeta.pageUrl}/` },
]);
const schemas = [...locationItems, breadcrumb, ...(localFaqs?.length > 0 ? [generateFAQSchema(localFaqs)] : [])];
---

<BaseLayout
  title="Inglés cerca de La Paz | Cambridge desde 64 €/mes | Impulse"
  description="Mismo distrito y mismo código postal que el barrio de La Paz. Centro oficial Cambridge, grupos de 7 a 10, desde 64 €/mes y 29 €/hora particular. 5,0 sobre 183 reseñas. Prueba de nivel gratis con JP: 604 910 611."
  keywords="academia inglés la paz madrid, clases inglés la paz, cursos inglés la paz madrid, cambridge la paz, aprender inglés la paz"
  canonical="/academia-ingles-la-paz/"
  fullTitle={true}
  schemas={schemas}
>
  <LaPazPage client:idle />
  <CookieBanner client:idle />
</BaseLayout>
