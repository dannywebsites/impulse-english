---
import BaseLayout from '../layouts/BaseLayout.astro';
import PenagrandePage, { locationMeta, localFaqs } from '../../pages/ubicaciones/PenagrandePage';
import CookieBanner from '../../components/CookieBanner';
import { generateLocationPageSchema, generateFAQSchema, generateBreadcrumbSchema } from '../../utils/schemaData';

const locationSchema = generateLocationPageSchema(locationMeta);
const locationItems = locationSchema["@graph"] || [locationSchema];
const breadcrumb = generateBreadcrumbSchema([
  { name: 'Inicio', url: 'https://impulse-english.es/' },
  { name: 'Ubicaciones', url: 'https://impulse-english.es/academias-ingles-madrid/por-barrios/' },
  { name: locationMeta.locationName, url: `${locationMeta.pageUrl}/` },
]);
const schemas = [...locationItems, breadcrumb, ...(localFaqs?.length > 0 ? [generateFAQSchema(localFaqs)] : [])];
---

<BaseLayout
  title="Inglés a 3 min de Peñagrande | desde 64 €/mes | Impulse"
  description="Academia de inglés a tres minutos de Peñagrande por la línea 9, o 3-5 en coche por la Av. de Peñagrande. Centro oficial Cambridge, grupos de 7 a 10, desde 64 €/mes."
  keywords="academia inglés peñagrande, clases inglés peñagrande, cursos inglés peñagrande madrid, cambridge peñagrande, aprender inglés peñagrande"
  canonical="/academia-ingles-penagrande/"
  fullTitle={true}
  schemas={schemas}
>
  <PenagrandePage client:idle />
  <CookieBanner client:idle />
</BaseLayout>
